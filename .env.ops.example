# Template for .env.ops (gitignored, repo root). Copy to .env.ops and fill in —
# see agent-docs/plan-hosted-early-access.md §4 (Phase 0 part B) for where each
# value comes from and D10 for the full map of which file owns which secret.
#
# Loaded by `scripts/db-push-prod.sh` and `scripts/config-push-prod.sh`
# (`set -a; source .env.ops; set +a` — config-push-prod.sh sources
# `supabase/.env` on top of it, for the `env()` names the CLI itself reads) and
# by hand for one-off agent/ops work. Never referenced by any Vercel build or
# by the web app — `grep -rn "SERVICE_ROLE\|sb_secret" apps/web` must stay
# empty regardless of what lands in this file.
#
# The prod `sb_secret_…` key is deliberately NOT a line here — D10 says it is
# fetched with `supabase projects api-keys --project-ref "$SUPABASE_PROD_PROJECT_REF"`
# for one task at a time and never written to disk.

# --- Supabase CLI ------------------------------------------------------------
# dashboard/account/tokens → Generate new token. Lets the CLI skip `supabase
# login` entirely; everything after account creation is agent work.
SUPABASE_ACCESS_TOKEN=
SUPABASE_ORG_ID=

# --- Vercel --------------------------------------------------------------
# account/tokens → Create, scoped to the personal account.
VERCEL_TOKEN=

# --- Project refs (both from `supabase projects list` once created) --------
SUPABASE_DEV_PROJECT_REF=
SUPABASE_PROD_PROJECT_REF=

# --- DB passwords (generated once, e.g. `openssl rand -base64 32 | tr -d '/+='`,
# never rotated casually — rotating dev's breaks the existing `supabase link`) --
SUPABASE_DEV_DB_PASSWORD=
SUPABASE_PROD_DB_PASSWORD=

# --- Dev's publishable-pair secret key (admin-API scripts against DEV only;
# D3 makes it structurally impossible for this to reach prod through this file) --
SUPABASE_DEV_SECRET_KEY=

# --- Vercel cron (D4) --------------------------------------------------------
# 32 random chars, also set on the Vercel project (Production env). Checked by
# apps/web/src/app/api/keepalive/route.ts against the `Authorization: Bearer`
# header Vercel's own scheduler sends.
CRON_SECRET=
