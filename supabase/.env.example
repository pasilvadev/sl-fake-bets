# Template for supabase/.env (gitignored). Copy to supabase/.env and fill in.
#
# Read automatically by the Supabase CLI for every `env(NAME)` substitution in
# config.toml — `supabase start`, `supabase db push`/`db reset`, and
# `supabase config push` all resolve through this file. An unresolved name is a
# CLI warning, not a failure (plan-hosted-early-access.md §9 provenance), so a
# blank line here does not break local dev — it just means the hosted-only
# fields silently push empty until filled in.
#
# See plan-hosted-early-access.md D7/D10 for what each value is and where it
# comes from; D10 is the map of which of THIS repo's two env files (this one,
# or the root .env.ops) owns which secret.

# --- Google OAuth (config.toml [auth.external.google]) ----------------------
# The existing dev client (unchanged) — registered against
# http://127.0.0.1:54321/auth/v1/callback and JS origin http://localhost:3000.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# The "SL — production" client (Phase 0 part C, step 9) — registered against
# https://<prod-ref>.supabase.co/auth/v1/callback and JS origin
# https://<prod-host>. Read only by the [remotes.production] override below,
# so it is never touched by a plain `supabase db push --linked` against dev.
SUPABASE_AUTH_EXTERNAL_GOOGLE_PROD_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_PROD_SECRET=

# --- Hosted redirect allow-list ([auth] additional_redirect_urls) -----------
# Whole-value substitutions — each already includes its own `/**` suffix,
# because the CLI substitutes an entire string, never part of one.
# e.g. https://sl-fake-bets.vercel.app/**
SUPABASE_PROD_REDIRECT_URL=
# e.g. https://*-sl-3407.vercel.app/** (sl-3407 is the Vercel account/team
# slug from `vercel whoami`, not the project name — see D5).
SUPABASE_VERCEL_PREVIEW_REDIRECT_URL=

# --- [remotes.production] (D5) ----------------------------------------------
# Also set in the root .env.ops (D10), for the ops scripts. Duplicated here
# because the CLI's env() substitution reads THIS file, not .env.ops — Phase 2
# task 8 is what reconciles the two if the CLI needs them exported instead of
# read from this file (the [remotes.*] caveat in config.toml explains why that
# is still an open question).
SUPABASE_PROD_PROJECT_REF=
# The production origin, e.g. https://sl-fake-bets.vercel.app — no trailing
# slash. Also lives in Vercel's own env store under the same name; this copy
# is what lets `supabase config push --project-ref <prod-ref>` set the prod
# project's site_url without a hosted env var to read from.
NEXT_PUBLIC_SITE_URL=
